{
  "name": "monarch-next-template",
  "version": "1.0.0",
  "description": "Reusable company-website starter: Next.js + Payload CMS (Postgres, Blob storage), bilingual by default.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation BLOB_READ_WRITE_TOKEN=vercel_blob_rw_dummy_x payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "media:sizes": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/regenerate-image-sizes.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation BLOB_READ_WRITE_TOKEN=vercel_blob_rw_dummy_x payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test-db:create": "node scripts/create-local-postgres-db.mjs --name monarch_test --env TEST_DATABASE_URL",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "vercel-build": "pnpm run migrate && pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/live-preview-react": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/storage-vercel-blob": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@tailwindcss/postcss": "^4.3.5",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.10",
    "graphql": "^17.1.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "next": "16.4.6",
    "payload": "3.94.2",
    "postcss": "^8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@neon/config": "^1.14.8",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
