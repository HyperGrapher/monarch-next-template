# ── Payload ───────────────────────────────────────────────────────────────────
# Long random string (openssl rand -hex 32). Required for build and runtime.
PAYLOAD_SECRET=

# ── Public site ───────────────────────────────────────────────────────────────
# Canonical origin used for sitemap, canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: if set, /api/preview also requires ?secret=<this value> (in addition to an admin session).
PREVIEW_SECRET=

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Use Neon's POOLED connection string (host contains "-pooler"), with ?sslmode=require.
DATABASE_URL=

# ── Media (Vercel Blob) ──────────────────────────────────────────────────────
# Create a PUBLIC Blob store in the Vercel project (Storage tab); Vercel injects this on its own.
# Leave empty locally: uploads then go to ./media on disk (never on Vercel — read-only filesystem).
BLOB_READ_WRITE_TOKEN=

# Optional absolute origin for Payload-generated URLs. Leave unset to use relative URLs.
# NEXT_PUBLIC_SERVER_URL=

# ── Optional contact e-mail delivery (NOT implemented: messages are stored in the CMS only) ──
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
EMAIL_API_KEY=

# ── Tests (see README → Testing). A THROWAWAY database only: the tests wipe it. ──
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/monarch_test
