# ── Payload ───────────────────────────────────────────────────────────────────
# Long random string (openssl rand -hex 32). Required for build and runtime.
PAYLOAD_SECRET=

# ── Public site ───────────────────────────────────────────────────────────────
# Canonical origin used for sitemap, canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: if set, /api/preview also requires ?secret=<this value> (in addition to an admin session).
PREVIEW_SECRET=

# ── Local development (no Cloudflare account needed) ─────────────────────────
# Use wrangler.local.jsonc (local D1/R2 via miniflare) instead of the remote bindings in wrangler.jsonc.
# The pnpm scripts dev:local / migrate:local / seed:local set this for you.
# WRANGLER_CONFIG=wrangler.local.jsonc

# ── Cloudflare (only for remote migrate/seed/build/deploy from your machine or CI) ──
# D1 and R2 are bound through wrangler.jsonc (bindings D1 and R2); no keys in the app.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ENV=

# ── Optional contact e-mail delivery (NOT implemented: messages are stored in the CMS only) ──
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
EMAIL_API_KEY=
