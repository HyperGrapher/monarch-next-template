{
  // Local-only bindings (miniflare). Used with: WRANGLER_CONFIG=wrangler.local.jsonc
  // Never touches the remote D1 database or R2 bucket.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "monarch-next-template-local",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [{ "binding": "D1", "database_id": "local-d1", "database_name": "monarch-next-local" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "monarch-next-local" }]
}
